---
import Layout from "../layouts/Layout.astro";
import { Card, CardContent } from "@/components/starwind/card";
---

<Layout>
  <div class="grid grid-cols-1 grid-rows-6 items-center justify-center h-screen w-full">
    <div class="row-span-1 h-full w-full text-center p-12">
      <h1 class="w-full text-4xl font-bold ">Beskriv ordet</h1>
      <h2 id="teller">Kort igjen: </h2>
    </div>

    <div id="game-container" class="mx-auto hidden w-full row-span-4 max-w-xs">
      <Card class:list={"w-full h-full"}>
        <CardContent class="flex aspect-square items-center justify-center text-center w-full h-full">
          <span id="word-display" class="break-normal text-4xl font-semibold transition-opacity duration-200">
            <!-- Cards will be injected here -->
          </span>
        </CardContent>
      </Card>
    </div>

    <div id="game-controls" class="hidden w-full h-full row-span-1">
      <button id="btn-skip" class="rounded-md bg-yellow-400 px-6 py-2 w-1/2 h-full font-medium text-white transition-colors hover:bg-yellow-500 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:ring-offset-2">
        Hopp over
      </button>
      <button id="btn-correct" class="rounded-md bg-green-500 px-6 py-2 w-1/2 h-full font-medium text-white transition-colors hover:bg-green-600 focus:outline-none focus:ring-2 focus:ring-green-400 focus:ring-offset-2">
        Riktig
      </button>
    </div>

    <p id="no-words-msg" class="hidden text-gray-500">
      Fant ingen ord i aliasen
    </p>
  </div>
</Layout>

<script>
  import { unpackWords } from "@/scripts/compression";
  import confetti from 'canvas-confetti';

  function initGame() {
    const params = new URLSearchParams(window.location.search);
    const wordsParam = params.get("words");

    const gameContainer = document.getElementById("game-container");
    const wordDisplay = document.getElementById("word-display");
    const gameControls = document.getElementById("game-controls");
    const noWordsMsg = document.getElementById("no-words-msg");
    const btnSkip = document.getElementById("btn-skip");
    const btnCorrect = document.getElementById("btn-correct");
    const teller = document.getElementById("teller");

    if (!gameContainer || !wordDisplay || !gameControls || !noWordsMsg || !btnSkip || !btnCorrect || !teller) return;

    if (!wordsParam) {
      noWordsMsg.classList.remove("hidden");
      return;
    }

    const wordsQueue = unpackWords(wordsParam)
      .split(",")
      .sort(() => Math.random() - 0.5);

    const renderCard = () => {
      if (wordsQueue.length > 0) {
        teller.textContent = "Kort igjen: "  + wordsQueue.length
      } else {
        teller.classList.add("hidden")
      }
      wordDisplay.style.opacity = "0";

      setTimeout(() => {
        if (wordsQueue.length === 0) {
          wordDisplay.textContent = "Ferdig!";
          gameControls.classList.add("hidden");
          gameControls.classList.remove("grid-cols-2");
          confetti()
        } else {
          wordDisplay.textContent = wordsQueue[0].trim();
        }
        wordDisplay.style.opacity = "1";
      }, 250);
    };

    btnCorrect.onclick = () => {
      wordsQueue.shift();
      renderCard();
    };

    btnSkip.onclick = () => {
      const skippedWord = wordsQueue.shift();
      if (skippedWord) wordsQueue.push(skippedWord);
      renderCard();
    };

    gameContainer.classList.remove("hidden");
    gameControls.classList.remove("hidden");
    gameControls.classList.add("grid-cols-2");
    renderCard();
  }

  initGame();
  document.addEventListener("astro:after-swap", initGame);
</script>
